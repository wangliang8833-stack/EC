{
  "name": "ecommerce-multi-shop-data-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Electron based multi-account ecommerce data collection and reporting platform",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.33.2"
  },
  "scripts": {
    "dev": "pnpm --filter @ecommerce/desktop dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "licenses:check": "node scripts/verify-license-lock.mjs",
    "audit:dependencies": "pnpm audit --audit-level high",
    "check": "pnpm licenses:check && pnpm typecheck && pnpm test && pnpm build && node scripts/verify-electron-preload.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"],
    "ignoredBuiltDependencies": ["electron-winstaller"]
  }
}
